{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy (policy/1)",
  "description": "Immutable once created. Its lifecycle state lives outside this object. fingerprint is the SHA-256 of the RFC 8785 canonical JSON of every other field (hashing.md). How the SDK evaluates it: sdk.md, 'Applying a policy'.",
  "type": "object",
  "required": [
    "schema",
    "policy_id",
    "question_id",
    "model_served",
    "type",
    "version",
    "created_at",
    "fit_id",
    "calibration",
    "rules",
    "fallback_action",
    "audit_fraction",
    "target",
    "guarantee",
    "metrics",
    "fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "policy/1" },
    "policy_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "question_id": { "$ref": "common.schema.json#/$defs/question_id" },
    "question_name": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/question_name" }, { "type": "null" }]
    },
    "model_served": { "$ref": "common.schema.json#/$defs/model" },
    "type": { "$ref": "common.schema.json#/$defs/type" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "fit_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "calibration": { "$ref": "fit.schema.json#/$defs/calibration" },
    "rules": {
      "description": "Checked in order; the first rule that fires decides. The compiler guarantees they don't overlap.",
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/rule" }
    },
    "option_actions": {
      "description": "choice only: options that return BLOCK, instead of SELECT, when the select rule fires on them.",
      "type": "array",
      "maxItems": 255,
      "items": { "$ref": "common.schema.json#/$defs/option_value" }
    },
    "fallback_action": {
      "description": "The action when no rule fires: the escalation band.",
      "const": "ESCALATE"
    },
    "audit_fraction": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "target": { "$ref": "#/$defs/target" },
    "guarantee": { "$ref": "#/$defs/guarantee" },
    "metrics": {
      "type": "object",
      "required": ["tune", "eval"],
      "additionalProperties": false,
      "properties": {
        "tune": { "$ref": "#/$defs/policy_metrics" },
        "eval": { "$ref": "#/$defs/policy_metrics" }
      }
    },
    "fingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" }
  },
  "$defs": {
    "scalar": {
      "description": "p: calibrated P(true) (noul). top: calibrated probability of the top option (choice). {tail_ge: k}: calibrated P(level >= k) (score).",
      "oneOf": [
        { "const": "p" },
        { "const": "top" },
        {
          "type": "object",
          "required": ["tail_ge"],
          "additionalProperties": false,
          "properties": { "tail_ge": { "type": "integer", "minimum": 1, "maximum": 9 } }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "action", "scalar", "op", "threshold"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["accept", "block", "select"] },
        "action": { "enum": ["ACCEPT", "BLOCK", "SELECT"] },
        "scalar": { "$ref": "#/$defs/scalar" },
        "op": { "enum": ["lt", "ge"] },
        "threshold": { "$ref": "common.schema.json#/$defs/probability" },
        "per_option": {
          "description": "choice only: a threshold for each option, used instead of threshold for that top option.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "threshold"],
            "additionalProperties": false,
            "properties": {
              "value": { "$ref": "common.schema.json#/$defs/option_value" },
              "threshold": { "$ref": "common.schema.json#/$defs/probability" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["risk", "cost"] },
        "metric": {
          "description": "risk only. false_pass: wrong among ACCEPTed. error_budget: every rule held to alpha.",
          "enum": ["false_pass", "error_budget"]
        },
        "alpha": { "type": "number", "minimum": 0.0001, "exclusiveMaximum": 1, "description": "Below 0.0001 a target needs millions of labeled items." },
        "delta": { "type": "number", "minimum": 0.000001, "exclusiveMaximum": 1 },
        "max_escalation": { "$ref": "common.schema.json#/$defs/probability" },
        "costs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "escalation": { "type": "number", "minimum": 0 },
            "wrong": {
              "description": "Cost of a wrong action, keyed by action: ACCEPT, BLOCK, SELECT.",
              "type": "object",
              "propertyNames": { "enum": ["ACCEPT", "BLOCK", "SELECT"] },
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "risk" } } },
          "then": { "required": ["metric", "alpha", "delta"] }
        },
        {
          "if": { "properties": { "kind": { "const": "cost" } } },
          "then": { "required": ["costs"] }
        }
      ]
    },
    "guarantee": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "method", "statement", "alpha", "delta", "assumptions", "n", "window"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "certified" },
            "method": { "const": "ltt-binomial/1" },
            "statement": { "type": "string", "minLength": 1 },
            "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "delta": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "n": {
              "description": "Labeled items each rule was certified on (tune split), keyed by rule id.",
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "window": { "$ref": "common.schema.json#/$defs/window" }
          }
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "none" },
            "reason": { "enum": ["cost_target", "adaptive_under_shift"] },
            "detail": { "type": "string" }
          }
        }
      ]
    },
    "policy_metrics": {
      "type": "object",
      "required": ["n", "automated", "escalated", "rules"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "automated": { "$ref": "common.schema.json#/$defs/probability" },
        "escalated": { "$ref": "common.schema.json#/$defs/probability" },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["fired", "wrong", "unlabeled", "rate", "ci95"],
            "additionalProperties": false,
            "properties": {
              "fired": { "type": "integer", "minimum": 0 },
              "wrong": { "type": "integer", "minimum": 0 },
              "unlabeled": { "type": "integer", "minimum": 0 },
              "rate": {
                "oneOf": [{ "$ref": "common.schema.json#/$defs/probability" }, { "type": "null" }]
              },
              "ci95": {
                "oneOf": [{ "$ref": "common.schema.json#/$defs/interval" }, { "type": "null" }]
              }
            }
          }
        },
        "expected_cost_per_1000": { "type": ["number", "null"] }
      }
    }
  }
}
